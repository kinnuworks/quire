{
  "name": "y-arkiv",
  "version": "0.1.0",
  "description": "Serverless real-time collaboration for Yjs, stored as encrypted Arkiv entities",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.build.json && vitest run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vectors": "tsx scripts/vectors.ts",
    "test:live": "LIVE=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "arkiv-encryption": "0.1.0",
    "lib0": "^0.2.119",
    "viem": "^2.57.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "y-arkiv": "./dist/cli.js",
    "quire": "./dist/cli.js"
  },
  "keywords": [
    "yjs",
    "crdt",
    "arkiv",
    "collaboration",
    "encryption",
    "local-first",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinnuworks/quire.git",
    "directory": "packages/y-arkiv"
  },
  "homepage": "https://github.com/kinnuworks/quire#readme"
}
