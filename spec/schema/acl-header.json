{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinnuworks/quire/blob/main/spec/schema/acl-header.json",
  "title": "ACL frame header (kind a). Epoch 0 carries the roster in clear (inside the meta-key envelope); later epochs seal it under the epoch key.",
  "type": "object",
  "required": [
    "v",
    "owner",
    "ownerPublicKey",
    "epoch",
    "keepUntil",
    "wraps"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "ownerPublicKey": {
      "type": "string",
      "pattern": "^0x04[0-9a-f]{128}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "keepUntil": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "wraps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x04[0-9a-f]{128}[0-9a-f]{120}$"
      },
      "description": "the epoch key sealed to each member (ephemeral key || envelope), unlabelled and in random order"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "address",
          "publicKey",
          "name",
          "role",
          "addedAtBlock"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^0x04[0-9a-f]{128}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "role": {
            "enum": [
              "owner",
              "writer"
            ]
          },
          "addedAtBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "atBlock"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "atBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    },
    "roster": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "AES-256-GCM envelope of {doc, epoch, members, revoked} under the current epoch key"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "epoch": {
          "const": 0
        }
      },
      "required": [
        "members",
        "revoked"
      ],
      "not": {
        "required": [
          "roster"
        ]
      }
    },
    {
      "properties": {
        "epoch": {
          "minimum": 1
        }
      },
      "required": [
        "roster"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "members"
            ]
          },
          {
            "required": [
              "revoked"
            ]
          }
        ]
      }
    }
  ]
}
