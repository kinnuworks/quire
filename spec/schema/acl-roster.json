{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinnuworks/quire/blob/main/spec/schema/acl-roster.json",
  "title": "Sealed ACL roster (epoch 1+), after decryption: unframed UTF-8 JSON under the epoch key, bound to its document and epoch",
  "type": "object",
  "required": [
    "doc",
    "epoch",
    "members",
    "revoked"
  ],
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "address",
          "publicKey",
          "name",
          "role",
          "addedAtBlock"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^0x04[0-9a-f]{128}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "role": {
            "enum": [
              "owner",
              "writer"
            ]
          },
          "addedAtBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "atBlock"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "atBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "addedAtBlock": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "when the membership this entry ends began; edits count only between addedAtBlock and atBlock"
          }
        }
      }
    },
    "doc": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "prior": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-f]{64}$"
      },
      "description": "keys of earlier epochs above 0, by epoch, so current members can read and prove edits written before the latest rotation"
    }
  }
}
