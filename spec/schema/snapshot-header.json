{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinnuworks/quire/blob/main/spec/schema/snapshot-header.json",
  "title": "Snapshot or version frame header (kind s or v); data is the first part of a Yjs v1 state update",
  "type": "object",
  "required": [
    "id",
    "base",
    "t",
    "chunks",
    "size",
    "authors"
  ],
  "properties": {
    "base": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "t": {
      "type": "integer"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-f]{64}$"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "authors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "address",
          "salt",
          "sig"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "salt": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "sig": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$"
          }
        }
      },
      "description": "client id to {address, salt}; valid only where clientIdFor(address, salt) equals the client id"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "random snapshot id; every chunk names it"
    }
  },
  "additionalProperties": false
}
