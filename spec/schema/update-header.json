{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinnuworks/quire/blob/main/spec/schema/update-header.json",
  "title": "Update frame header (kind u); data is a Yjs v1 update",
  "type": "object",
  "required": [
    "t",
    "salt",
    "sig"
  ],
  "properties": {
    "t": {
      "type": "integer",
      "description": "writer clock, ms since epoch"
    },
    "salt": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "session salt: the Yjs client id is clientIdFor(creator, salt)"
    },
    "sig": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$",
      "description": "EIP-191 signature by the creator over 'quire1:salt:' || doc (32) || salt (16)"
    }
  },
  "additionalProperties": false
}
